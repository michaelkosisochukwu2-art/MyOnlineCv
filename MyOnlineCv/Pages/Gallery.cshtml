@page
@model MyOnlineCv.Pages.GalleryModel
@{
    ViewData["Title"] = "Portfolio Gallery";
}

<div class="container mt-4">
    <h2 class="mb-4">Portfolio & Photo Gallery</h2>

    <!-- Upload Form -->
    <div class="card p-4 mb-5 shadow-sm">
        <h4>Upload New Image</h4>
        <form method="post" enctype="multipart/form-data" class="mt-3">
            <div class="mb-3">
                <input type="file" asp-for="ImageUpload" class="form-control" accept="image/*" required />
            </div>
            <button type="submit" class="btn btn-primary">Upload to Gallery</button>
        </form>
    </div>

    <!-- Gallery View -->
    <h3 class="mb-3">Gallery Items</h3>
    @if (Model.ImageUrls.Count == 0)
    {
        <p class="text-muted">No images uploaded yet. Use the form above to add your first photo.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var imageUrl in Model.ImageUrls)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@imageUrl" class="card-img-top" alt="Gallery Image" style="height: 220px; object-fit: cover;">
                    </div>
                </div>
            }
        </div>
    }
</div>