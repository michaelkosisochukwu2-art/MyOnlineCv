@page
@model MyOnlineCv.Pages.GalleryModel
@{
    ViewData["Title"] = "Photo Gallery";
}

<div class="container mt-4">
    <h2 class="mb-4">Photo Gallery</h2>

    <!-- Upload Form -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Upload New Photo</h5>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
                <div class="mb-3">
                    <label class="form-label">Image Title</label>
                    <input type="text" asp-for="Title" class="form-control" placeholder="Enter image title" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Select Image</label>
                    <input type="file" asp-for="UploadedImage" class="form-control" accept="image/*" required />
                </div>
                <button type="submit" class="btn btn-primary">Upload Photo</button>
            </form>
        </div>
    </div>

    <!-- Gallery Grid -->
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model.GalleryItems.Any())
        {
            @foreach (var photo in Model.GalleryItems)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@photo.ImageUrl" class="card-img-top" alt="@photo.Title" style="height: 220px; object-fit: cover;" />
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h5 class="card-title">@photo.Title</h5>
                            <p class="card-text text-muted small">Uploaded: @photo.UploadedAt.ToString("MMM dd, yyyy")</p>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@photo.Id" onsubmit="return confirm('Are you sure you want to delete this photo?');">
                                <button type="submit" class="btn btn-danger btn-sm w-100">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-muted">No photos uploaded yet.</p>
            </div>
        }
    </div>
</div>