@page
@model MyOnlineCv.Pages.EducationModel
@{
    ViewData["Title"] = "Education";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <h2 class="mb-3">Education & Qualifications</h2>
        <p class="text-muted">Academic credentials and professional software development training.</p>
        <hr />

        <div class="card p-4 shadow-sm mb-4 border-0 bg-light">
            <h4 class="text-primary">Bachelor of Science (B.Sc.)</h4>
            <h6 class="text-muted">University of Calabar, Cross River State</h6>
            <p class="mb-0"><strong>Graduation Year:</strong> 2024</p>
        </div>

        <div class="card p-4 shadow-sm mb-4 border-0 bg-light">
            <h4 class="text-primary">Backend Software Engineering Fellowship</h4>
            <h6 class="text-muted">Conclase Academy & Bincom Academy</h6>
            <p class="mb-0">Intensive software development training focused on C#, ASP.NET Core, Object-Oriented Programming, Entity Framework Core, SQL Server, and Microsoft Azure Cloud Deployment.</p>
        </div>
    </div>
</div>